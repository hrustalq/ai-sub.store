# Server
PORT=3000

# Logging (trace | debug | info | warn | error | fatal)
# LOG_LEVEL=info
# LOG_FORMAT=json   # json (default, Loki-friendly) | pretty (local dev)

# Swagger UI: http://localhost:3000/api/docs

# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Telegram Bot (required)
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Webhook mode (production) — leave unset for local polling
# TELEGRAM_WEBHOOK_DOMAIN=https://your-domain.com
# TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Public URL for legal pages (/legal/privacy, /legal/terms) and YooKassa return URL
# Defaults to TELEGRAM_WEBHOOK_DOMAIN when set
# PUBLIC_BASE_URL=https://your-domain.com

# YooKassa (required for payments — all prices are in RUB)
# Merchant profile: https://yookassa.ru → Интеграция → Ключи API
# Webhook URL: https://your-domain.com/webhooks/yookassa (event: payment.succeeded)
# YOOKASSA_SHOP_ID=your_shop_id
# YOOKASSA_SECRET_KEY=your_secret_key

# Admin Telegram user IDs (comma-separated) for /confirm <order-id>
ADMIN_TELEGRAM_IDS=123456789

# Admin API key for REST endpoints (optional in dev — required header: x-admin-api-key)
# ADMIN_API_KEY=your_secret_api_key

# Docker / Grafana (used by docker-compose)
# GRAFANA_PORT=3001
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change_me
